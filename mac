#!/bin/sh

set -eu

# Stable HTTPS shortcut for the canonical reviewed installer Gist. Download the
# complete script before parsing or executing any of it.
gist_url="https://gist.githubusercontent.com/wozi-x/3a9aea7de1296af6147bacaaae96f6fb/raw/install-codex-and-gh-macos.sh"
installer_file="$(mktemp "${TMPDIR:-/tmp}/pkgmacsetup-public.XXXXXX")"

cleanup() {
  rm -f -- "$installer_file"
}

trap cleanup EXIT
trap 'exit 1' HUP INT TERM

curl --fail --silent --show-error --location \
  --proto '=https' \
  --proto-redir '=https' \
  --tlsv1.2 \
  --output "$installer_file" \
  "${gist_url}?$(date +%s)"

[ -s "$installer_file" ] || {
  printf 'Error: downloaded installer is empty.\n' >&2
  exit 1
}

/bin/bash -n "$installer_file"
/bin/bash "$installer_file"

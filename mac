#!/bin/bash -p

set -eu

# Download a complete public checkout before running its entrypoint. The current
# installer imports adjacent files and intentionally cannot run as one script.
archive_url="https://github.com/wozi-x/PKGMacSetupPublic/archive/refs/heads/main.tar.gz"
work_dir="$(mktemp -d "${TMPDIR:-/tmp}/pkgmacsetup-public.XXXXXX")"
archive_file="${work_dir}/public.tar.gz"
checkout_dir="${work_dir}/checkout"

cleanup() {
  rm -rf -- "$work_dir"
}

trap cleanup EXIT
trap 'exit 1' HUP INT TERM

curl --fail --silent --show-error --location \
  --proto '=https' \
  --proto-redir '=https' \
  --tlsv1.2 \
  --output "$archive_file" \
  "${archive_url}?$(date +%s)"

[ -s "$archive_file" ] || {
  printf 'Error: downloaded public repository archive is empty.\n' >&2
  exit 1
}

mkdir -p "$checkout_dir"
tar -xzf "$archive_file" --strip-components=1 -C "$checkout_dir"

[ -f "$checkout_dir/install.sh" ] && [ -f "$checkout_dir/setup.sh" ] || {
  printf 'Error: downloaded public repository archive is incomplete.\n' >&2
  exit 1
}

/bin/bash -p -n "$checkout_dir/install.sh"
/bin/bash -p -n "$checkout_dir/setup.sh"

cd "$checkout_dir"
if [ "$#" -eq 0 ]; then
  set -- --help
fi
/bin/bash -p ./install.sh "$@"

#!/bin/bash -p

set -eu

# Stable HTTPS shortcut for the canonical reviewed installer Gist. Download the
# complete script before parsing or executing any of it.
installer_url="https://raw.githubusercontent.com/wozi-x/PKGMacSetupPublic/main/install.sh"
installer_file="$(mktemp "${TMPDIR:-/tmp}/pkgmacsetup-public.XXXXXX")"

cleanup() {
  rm -f -- "$installer_file"
}

trap cleanup EXIT
trap 'exit 1' HUP INT TERM

curl --fail --silent --show-error --location \
  --proto '=https' \
  --proto-redir '=https' \
  --tlsv1.2 \
  --output "$installer_file" \
  "${installer_url}?$(date +%s)"

[ -s "$installer_file" ] || {
  printf 'Error: downloaded installer is empty.\n' >&2
  exit 1
}

/bin/bash -p -n "$installer_file"
/bin/bash -p "$installer_file"
